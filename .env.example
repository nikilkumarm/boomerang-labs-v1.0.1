# ==========================================
# BOOMERANG LABS - CONTACT FORM EMAIL CONFIG
# ==========================================
# Choose ONE of the methods below and put the values in your .env.local file:

# Target email to receive incoming inquiries:
CONTACT_EMAIL=hello@boomeranglabs.in

# ----------------------------------------------------
# OPTION A: Gmail / Google Workspace (Recommended)
# ----------------------------------------------------
# To get a Gmail App Password:
# 1. Go to your Google Account -> Security -> 2-Step Verification
# 2. Scroll to the bottom and click "App Passwords"
# 3. Create one named "Boomerang Website" and copy the 16-character code
# GMAIL_USER=your-email@gmail.com
# GMAIL_PASS=xxxx xxxx xxxx xxxx

# ----------------------------------------------------
# OPTION B: Custom Domain SMTP (Zoho, Hostinger, cPanel, etc.)
# ----------------------------------------------------
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_USER=hello@boomeranglabs.in
# SMTP_PASS=your_email_password
